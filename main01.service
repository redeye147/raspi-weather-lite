[Unit]
Description=Weather Signage Display
After=network.target wifi-setup-auto.service
Wants=wifi-setup-auto.service
# 起動失敗が続くときは 10 分で 5 回までで諦める（無限再起動で CPU を食い潰さない）
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/pi/raspi-weather-lite
# bash 経由で起動する：start.sh に実行権が無くても（更新で git がファイルを入れ替えたとき等）、起動に失敗しない（status=203/EXEC の対策）
ExecStart=/bin/bash /home/pi/raspi-weather-lite/start.sh
Restart=on-failure
RestartSec=30
# 停止指示から 10 秒で強制終了（既定の 90 秒待ちで再起動・シャットダウンが遅くならないように）
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
